ENVIRONMENT=development
PORT=8000

# Generate a long random secret for production.
GATEWAY_JWT_SECRET=replace-with-a-long-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATEWAY_ENCRYPTION_KEY=replace-with-a-fernet-key

# Optional operator-only token for future admin endpoints.
GATEWAY_ADMIN_TOKEN=

SESSION_TTL_SECONDS=1800
MAX_REQUESTS_PER_MINUTE=60
MAX_INPUT_BYTES=1048576
MAX_OUTPUT_TOKENS=4096

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional user identity binding for BYOK owner isolation; anonymous BYOK still works.
# Leave both unset to keep anonymous BYOK. Set both to enable verified user scopes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional identity binding for the Studio client-key workspace.
# Set the same random 32+ character secret on the Studio Cloudflare Worker
# (WORKSPACE_GATEWAY_IDENTITY_SECRET) and this Gateway service.
# When a signed client assertion is present, the Gateway assigns a stable
# per-client owner scope across BYOK reconnects. Public anonymous BYOK remains
# per-session scoped when no assertion is sent.
WORKSPACE_IDENTITY_SECRET=

# Wix/custom frontend origins, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
CORS_ALLOW_ORIGIN_REGEX=

# Server-side suggested presets shown in the portfolio workbench.
# BYOK users may opt into a custom provider model ID per temporary session;
# the Gateway still validates the provider and model identifier.
# Example format:
# MODEL_REGISTRY_JSON=[{"id":"openai-default","provider":"openai","model_id":"gpt-4o-mini","recommended":true},{"id":"gemini-default","provider":"google","model_id":"gemini-2.5-flash","recommended":true},{"id":"anthropic-default","provider":"anthropic","model_id":"claude-3-5-haiku-latest"}]
MODEL_REGISTRY_JSON=

# Optional controlled fallback. Keep disabled unless you intentionally want to demo with your own key.
FALLBACK_PROVIDER=
FALLBACK_MODEL_ID=
FALLBACK_API_KEY=

# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Asaif Ali Portfolio Demo

# Optional: only for Anthropic keys that require workspace scoping.
ANTHROPIC_WORKSPACE_ID=
